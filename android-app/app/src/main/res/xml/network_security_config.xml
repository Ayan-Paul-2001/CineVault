<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow user-configured local BDIX / ISP HTTP directory servers dynamically without hardcoding IPs.
        App self-updates (UpdateService / ServerConfig.isTrustedUpdateUrl) remain strictly HTTPS-only,
        and ServerConfig.isAllowedUrl enforces the dynamic SQLite server allowlist + loopback/SSRF blocking.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
