<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/exo_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false" />

    <!-- Full-screen VLC-style Gesture Surface (Left = Brightness, Right = Volume + 200% Boost, Tap = Toggle UI) -->
    <View
        android:id="@+id/player_gesture_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Custom Cinema Subtitle Overlay (supports live size + timing sync offset) -->
    <TextView
        android:id="@+id/cinema_subtitle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="26dp"
        android:background="#B805070C"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:shadowColor="#000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- VLC-Style Brightness / Volume Boost Vertical Slider HUD -->
    <LinearLayout
        android:id="@+id/player_gesture_hud"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_rounded"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gesture_hud_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Level"
            android:src="@drawable/ic_brightness" />

        <FrameLayout
            android:id="@+id/gesture_bar_track"
            android:layout_width="8dp"
            android:layout_height="120dp"
            android:layout_marginVertical="10dp"
            android:background="#33FFFFFF">

            <View
                android:id="@+id/gesture_bar_fill"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="#F59E0B" />
        </FrameLayout>

        <TextView
            android:id="@+id/gesture_hud_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gesture_hud_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Volume"
            android:textColor="@color/cv_text_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- VLC-Style Video Size / Aspect Ratio Center OSD Pill -->
    <LinearLayout
        android:id="@+id/player_scale_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_rounded"
        android:elevation="9dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Video Size"
                android:src="@drawable/ic_aspect_ratio" />

            <TextView
                android:id="@+id/scale_hud_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Best Fit"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/scale_hud_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Tap Fit to cycle · Long-press for all"
            android:textColor="@color/cv_text_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/player_buffering"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/cv_accent" />

    <!-- Overlay Controls -->
    <FrameLayout
        android:id="@+id/player_controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#BB000000"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/btn_player_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tv_button_focus"
                android:contentDescription="Back"
                android:focusable="true"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/player_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/cv_text_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_player_rotate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tv_button_focus"
                android:contentDescription="Rotate"
                android:focusable="true"
                android:src="@drawable/ic_rotate"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Center Transport -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/btn_player_rew"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_dark"
                android:contentDescription="Rewind 10s"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_replay_10"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_player_play_pause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="26dp"
                android:background="@drawable/bg_circle_accent"
                android:contentDescription="Play or Pause"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_pause"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_player_fwd"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_dark"
                android:contentDescription="Forward 10s"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_forward_10"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Bottom Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_pos_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/player_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:progressTint="@color/cv_accent"
                    android:thumbTint="@color/cv_accent" />

                <TextView
                    android:id="@+id/player_dur_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_player_next_ep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tv_button_focus"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Next Ep"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btn_player_scale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tv_button_focus"
                        android:clickable="true"
                        android:drawablePadding="5dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Fit"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_aspect_ratio" />

                    <TextView
                        android:id="@+id/btn_player_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tv_button_focus"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Audio"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_player_cc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tv_button_focus"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="CC"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_player_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tv_button_focus"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Quality"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btn_player_external"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tv_button_focus"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="VLC"
                        android:textColor="@color/cv_sky"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
